{
  "name": "tomaj/bank-mails-parser",
  "description": "Professional PHP library for parsing bank confirmation emails from Slovak and Czech banks",
  "type": "library",
  "license": "LGPL-2.0-or-later",
  "keywords": [
    "bank",
    "email",
    "parser",
    "tatrabanka",
    "csob",
    "vub",
    "slovakia",
    "czech",
    "payment",
    "transaction",
    "iban",
    "sepa"
  ],
  "authors": [
    {
      "name": "Tomas Majer",
      "email": "tomasmajer@gmail.com",
      "homepage": "http://tomaj.sk"
    }
  ],
  "support": {
    "issues": "https://github.com/tomaj/bank-mails-parser/issues",
    "source": "https://github.com/tomaj/bank-mails-parser",
    "docs": "https://github.com/tomaj/bank-mails-parser#readme"
  },
  "require": {
    "php": "^8.4",
    "singpolyma/openpgp-php": "^0.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "infection/infection": "^0.35",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "minimum-stability": "stable",
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "cs": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs-fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse",
    "infection": "infection --min-msi=89 --min-covered-msi=90 --threads=max",
    "check": [
      "@cs",
      "@phpstan",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "test": "Run PHPUnit tests with coverage",
    "cs": "Check code style (PER-CS/PSR-12 + PHP 8.4)",
    "cs-fix": "Fix code style violations automatically",
    "phpstan": "Run static analysis with PHPStan",
    "infection": "Run mutation testing with Infection",
    "check": "Run all quality checks (code style, static analysis, tests)"
  },
  "archive": {
    "exclude": [
      "/tests",
      "/.github",
      "/.gitattributes",
      "/.gitignore",
      "/phpunit.xml.dist",
      "/phpstan.neon",
      "/infection.json5",
      "/build"
    ]
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
