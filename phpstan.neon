includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    paths:
        - src
    ignoreErrors:
        - path: src/Parser/TatraBanka/TatraBankaMailDecryptor.php
          message: '#Instanceof between mixed and OpenPGP_SecretSubkeyPacket#'
        - path: src/Parser/TatraBanka/TatraBankaMailDecryptor.php
          message: '#^(Argument of an invalid type|Cannot access|Method .* should return)#'