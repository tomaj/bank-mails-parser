includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    paths:
        - src
    ignoreErrors:
        # OpenPGP library has dynamic types and lacks proper type annotations
        - '#Instanceof between mixed and OpenPGP_SecretSubkeyPacket will always evaluate to false#'
        - path: src/Parser/TatraBanka/TatraBankaMailDecryptor.php
          message: '#^(Argument of an invalid type|Cannot access|Method .* should return)#'